# Build output and IDE metadata
target/
.idea/
*.iml
.settings/
.classpath
.project
node_modules/
.DS_Store

# Local credentials
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
*.pem
*.key
config/

# Public demo profiles (no personal credentials)
!mall-admin/src/main/resources/application-local.yml
!mall-portal/src/main/resources/application-local.yml
!mall-search/src/main/resources/application-local.yml

# Generated logs and Python cache
*.log
logs/
__pycache__/
*.pyc

# Public frontend build configuration (local credentials belong in .env.local).
!frontend/admin/.env
!frontend/admin/.env.development
!frontend/admin/.env.production
!frontend/storefront/.env
!frontend/storefront/.env.development
!frontend/storefront/.env.production
